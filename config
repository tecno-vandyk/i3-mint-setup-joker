# =============================================================================
# ARCHIVO DE CONFIGURACIÓN DE I3WM (v4)
# Documentación oficial: https://i3wm.org/docs/userguide.html
# =============================================================================

# Define la tecla SUPER/WINDOWS como la tecla principal ($mod)
set $mod Mod4

# Fuente predeterminada para los títulos de ventanas y barra de estado
font pango:monospace 9

# Autoinicio de aplicaciones integradas en el sistema (.desktop)
exec --no-startup-id dex --autostart --environment i3

# Gestión de bloqueo automático de pantalla al suspender el equipo
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# Applet de red para la bandeja del sistema (gestión de Wi-Fi y cable)
exec --no-startup-id nm-applet

# =============================================================================
# INICIO AUTOMÁTICO DE HERRAMIENTAS VISUALES Y EFECTOS
# =============================================================================

# 1. Cargar fondo de pantalla con feh al iniciar i3
exec_always --no-startup-id feh --bg-fill "/home/vandyk/Imágenes/joker.jpg"

# 2. Iniciar Picom (Compositor para transparencias y esquinas redondeadas)
exec_always --no-startup-id picom --corner-radius 12 -b

# =============================================================================
# ESPACIAMIENTO (GAPS), BORDES Y ESTILOS VISUALES
# =============================================================================

# --- ANCHO DE BORDES (AJUSTABLE) ---
# Cambia el número '2' por el grosor en píxeles que prefieras (ej: pixel 1, pixel 3, pixel 4)
default_border pixel 3
default_floating_border pixel 3

# Espaciado entre ventanas (gaps inner) y entre ventanas y pantalla (gaps outer)
gaps inner 8
gaps outer 4

# Ocultar bordes de pantalla cuando solo hay una ventana abierta
#hide_edge_borders smart


# --- COLORES DE BORDES Y FOCO ---
# Estructura: class                borde    fondo    texto    indicador  borde_hijo

# Ventana Enfocada: 
# Borde: Morado Oscuro (#4c1d95) | Indicador nueva ventana: Morado Claro (#a855f7)
client.focused                   #4c1d95  #4c1d95  #ffffff  #a855f7    #4c1d95

# Ventanas No Enfocadas (Gris oscuro disimulado)
client.unfocused                 #2d2d2d  #2d2d2d  #888888  #2d2d2d    #2d2d2d

# Ventana enfocada pero en otro monitor / contenedor
client.focused_inactive          #3b0764  #3b0764  #cccccc  #2d2d2d    #3b0764

# Ventana en estado urgente o alerta
client.urgent                    #ef4444  #ef4444  #ffffff  #dc2626    #ef4444

# Marcador de posición al arrastrar o dividir
client.placeholder               #18181b  #18181b  #ffffff  #18181b    #18181b


